# Free Fire Sensitivity OB54 - Environment Variables
# Copy this to .env.local and fill in your values

# ===========================================
# REQUIRED FOR PRODUCTION
# ===========================================

# License Key HMAC Secret (min 32 chars, use: openssl rand -hex 32)
LICENSE_SECRET_KEY=your-super-secret-license-key-min-32-chars-here

# Admin Password Hash (SHA-256 of your password)
# Generate with: node -e "console.log(require('crypto').createHash('sha256').update('your-password').digest('hex'))"
ADMIN_PASSWORD_HASH=your-admin-password-hash-here

# ===========================================
# OPTIONAL: Upstash Redis (for rate limiting & analytics)
# Get from: https://console.upstash.com/redis
# Free tier: 10K requests/day, 256MB
# ===========================================

UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# ===========================================
# OPTIONAL: Sentry Error Tracking
# Get from: https://sentry.io/
# Free tier: 5K errors/month
# ===========================================

SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ===========================================
# OPTIONAL: Vercel Analytics (auto-enabled on Vercel)
# ===========================================

# No config needed - automatically enabled on Vercel

# ===========================================
# DEVELOPMENT OVERRIDES
# ===========================================

# Set to 'development' for local dev
NODE_ENV=development

# Vercel will inject these automatically in production
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=your-project.vercel.app